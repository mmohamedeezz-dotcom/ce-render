{"code": "MOTION", "kind": "reel", "fps": 60, "voice_id": "UR972wNGq3zluze0LoIp", "html": "<!DOCTYPE html><html dir=\"rtl\" lang=\"ar\"><head><meta charset=\"utf-8\"><link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/gh/mmohamedeezz-dotcom/ce-render@main/kit.css\"><script src=\"https://cdn.jsdelivr.net/gh/mmohamedeezz-dotcom/ce-render@main/kit.js\"></script><style>body{--brand:#C8963E;--accent:#7A2E1D;--paper:#F3E9DC;--ink:#1A1410}</style></head><body data-brand=\"بُن الساعة ٦\" data-music=\"warm instrumental, soft fingerstyle acoustic guitar with light brushed percussion and subtle upright bass, around 95 BPM, calm confident morning mood, minimal and clean, no vocals\">\n<section class=\"scene hook t-dark\" data-vo=\"قَهْوِتك اللي في البيت اتحمَّصِت *إمتى*؟\" data-sfx=\"deep soft whoosh with a single clock tick\"><div class=\"k-stage\"><i class=\"k-ico xl\">schedule</i></div></section>\n<section class=\"scene t-light\" data-vo=\"تِسأل البايع يقولك *مش فاكر*\" data-sfx=\"two soft message pop sounds\"><div class=\"k-stage\"><div class=\"k-chat\"><p class=\"in\">اتحمّصت إمتى؟</p><p class=\"out\">هسأل وأرجعلك</p></div><div class=\"k-tag\">مشهد تمثيلي</div></div></section>\n<section class=\"scene t-brand\" data-vo=\"إحنا بنطبع *التاريخ* على الكيس\" data-sfx=\"rubber stamp thud on paper\"><div class=\"k-stage\"><i class=\"k-ico lg\">inventory_2</i><div class=\"k-card\"><b>يوم التحميص</b><small>قدام عينك</small></div></div></section>\n<section class=\"scene t-dark\" data-vo=\"خلال تَمانية وأربعين *ساعة* من التحميص\" data-sfx=\"fast digital counter ticking up then a soft ding\"><div class=\"k-stage\"><div class=\"k-stat\"><b class=\"k-num\" style=\"--to:48\"></b><i>ساعة</i><small>والكيس لسه طازة</small></div></div></section>\n<section class=\"scene t-light\" data-vo=\"بنحمّص *بعد* ما تطلب\" data-sfx=\"three quick soft click sounds in rhythm\"><div class=\"k-stage\"><div class=\"k-card\"><div class=\"k-row\"><i class=\"k-ico\" style=\"--c:#C8963E\">chat</i><div><b>اطلب واتساب</b><small>الطلب هنا بس</small></div></div><div class=\"k-row\"><i class=\"k-ico\" style=\"--c:#7A2E1D\">local_fire_department</i><div><b>تحميص طازة</b><small>أحد وأربعاء</small></div></div><div class=\"k-row\"><i class=\"k-ico\" style=\"--c:#C8963E\">local_shipping</i><div><b>توصيل للباب</b><small>القاهرة والجيزة</small></div></div></div></div></section>\n<section class=\"scene t-brand\" data-vo=\"اتأكد *بنفسك* مش بكلامنا\" data-sfx=\"three light check mark chimes\"><div class=\"k-stage\"><ul class=\"k-list\"><li>دوّر على التاريخ</li><li>قارنه بيوم طلبك</li><li>الحكم ليك</li></ul></div></section>\n<section class=\"scene t-light\" data-vo=\"جرّب كيس *بِستين* جنيه\" data-sfx=\"coin drop with a soft register ding\"><div class=\"k-stage\"><div class=\"k-price\"><b>60</b><small>جنيه</small></div><div class=\"k-tag\">كيس واحد لكل عميل</div></div></section>\n<section class=\"scene t-dark\" data-vo=\"الدفعة فيها *مِيّة وخمسين* كيس بس\" data-sfx=\"quick counter roll with a soft final thump\"><div class=\"k-stage\"><div class=\"k-stat\"><b class=\"k-num\" style=\"--to:150\"></b><i>كيس</i><small>الكمية محدودة</small></div></div></section>\n<section class=\"scene t-light\" data-vo=\"اطلب قبل *اتناشر* بالليل السبت والتلات\" data-sfx=\"clock tick then a soft alarm bell\"><div class=\"k-stage\"><div class=\"k-card\"><div class=\"k-row\"><i class=\"k-ico\" style=\"--c:#7A2E1D\">calendar_month</i><div><b>آخر طلب</b><small>السبت والتلات</small></div><em>12 ليلًا</em></div></div></div></section>\n<section class=\"scene end t-brand\" data-vo=\"*اقرا التاريخ* على الكيس\" data-sfx=\"warm confident stamp hit with a short musical resolve\"><div class=\"k-stage\"><a class=\"k-cta\">اطلب على واتساب</a></div></section>\n</body></html>"}